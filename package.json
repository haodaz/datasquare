{
  "name": "zhiji-v2",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "mcp:fetch-tools": "npx tsx src/lib/mcp/fetch_mcp_tools.ts",
    "mcp:gen-types": "npx tsx src/lib/mcp/gen_mcp_types.ts",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",
    "electron:build": "next build --webpack && electron-builder",
    "export": "next build --webpack"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.4",
    "@types/marked": "^5.0.2",
    "antd": "^6.4.2",
    "duck-duck-scrape": "^2.2.7",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "next": "16.2.6",
    "openai": "^6.44.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "pinyin": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.pingfangchuangxiang.zhiji-v2",
    "productName": "知己",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "!**/node_modules/.cache/**"
    ]
  }
}
