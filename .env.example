# ── API Keys ──────────────────────────────────────────────────────────────────
# Anthropic API Key (Required for Claude models)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API Key (Required for Gemini models and Image Generation)
# https://aistudio.google.com
GEMINI_API_KEY=AIza-your-key-here

# DashScope API Key (For DeepSeek and other models via Alibaba)
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-key-here

# Search API Keys
# Bocha Search (Recommended for China) - https://open.bochaai.com
BOCHA_API_KEY=your-bocha-key-here
# Brave Search - https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-key-here

# ── Model Configuration ───────────────────────────────────────────────────────
# Default: claude-3-5-sonnet-20241022
NEXT_PUBLIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# DeepSeek Model via DashScope
DEEPSEEK_MODEL=deepseek-v3.2-exp
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Flora / Dash Integration ──────────────────────────────────────────────────
# Flora Host & Auth
FLORA_HOST=https://polarise-ss-alpha.nx1.applysquare.net
FLORA_AUTH_BEARER=your-token-here

# Zhiji Host (Legacy support or bridge)
NEXT_PUBLIC_ZHIJI_HOST=https://polarise-mesquareai-next-alpha-test.nx1.applysquare.net
ZHIJI_HOST=https://polarise-mesquareai-next-alpha-test.nx1.applysquare.net

# ── VisionSquare Data Integration ──────────────────────────────────────────────────
VISIONSQUARE_DATA_HOST=https://visionsquare-data-prod.nx1.applysquare.net
VISIONSQUARE_AUTH_BEARER=xxx

# ── Cache ────────────────────────────────────────────────────────────────────
# Redis 连接配置 (可选，不配 HOST 则跳过缓存直接回源)
FLORA_REDIS_HOST=127.0.0.1
# FLORA_REDIS_PORT=6379  # 默认 6379，可按需覆盖

# ── Local Development ────────────────────────────────────────────────────────
# Data Storage Directory (Default: ./data)
ZHIJI_DATA_DIR=./data

# Ollama Configuration
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ── Lead CRM 

# ORCID Public API (人才验真 - 学者档案检索)
# ORCID_CLIENT_ID=your-client-id
# ORCID_CLIENT_SECRET=your-client-secret
